# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Kraken key needs "Query Funds" + "Create & Modify Orders". Do NOT enable
# withdrawal permissions on a key used by a bot.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ---------------------------------------------------------------- safety
# Three independent gates. All must be on before real money moves.
TRADE_ENABLED=false
LIVE=false
CONFIRM_LIVE_TRADING=

# ------------------------------------------------------------- universe
# Assets a cycle may start and end in. You must hold one of these.
START_ASSETS=USD
# Only track the N most liquid pairs (by 24h quote volume). Keeps the
# websocket subscription and per-tick scan manageable.
MAX_PAIRS=180
# Ignore pairs whose 24h quote volume is below this (in quote units).
MIN_PAIR_VOLUME=250000

# ------------------------------------------------------------ detection
# Net profit threshold, in basis points, AFTER fees and depth-walking.
# Below ~5bps you are trading noise; Kraken taker is 26bps/leg at tier 0,
# so a 3-leg cycle must overcome ~78bps before it clears anything.
MIN_PROFIT_BPS=8
# Reject any book older than this. Stale quotes are how paper profits die.
MAX_BOOK_AGE_MS=1500
SCAN_INTERVAL_SECONDS=0.5

# -------------------------------------------------------------- sizing
TRADE_SIZE=50
MAX_TRADE_SIZE=200
# Overrides the fee tier fetched from your account. Leave blank to auto-detect.
TAKER_FEE_BPS=

# ---------------------------------------------------------------- risk
MAX_CYCLES_PER_HOUR=12
MAX_DAILY_LOSS=25
COOLDOWN_AFTER_FAILURE_SECONDS=60
# Price buffer added to each IOC limit leg so it actually crosses.
SLIPPAGE_BPS=5
# If a leg fills partially and the cycle can't continue, market out of the
# stranded asset instead of leaving it sitting there.
UNWIND_ON_FAILURE=true

# ------------------------------------------------------------- alerting
DISCORD_WEBHOOK=
